setWebserverConfig({password = "$scrypt$ln=10,p=1,r=8$QJMKTudr7X2QK7bIefDNKw==$slzMEEZZNzpCooMVNeLhvApisJiClUeqMel8CUOdp/A=", apiKey = "$scrypt$ln=10,p=1,r=8$2wDcajr7qBHkM9eKCKyEtA==$G/+hUZ7DENpAesFMqepEejB/IPquRs829ziP6nscWUs=", acl = "127.0.0.1/32, ::1/128", statsRequireAuthentication = true})

