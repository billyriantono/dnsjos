#!/bin/sh
# DnsJos node installer (SPEC §13), served by the panel at /install.sh.
#   curl -fsSL {{.PanelURL}}/install.sh | sudo sh -s -- --token TOKEN [--panel URL] [--adopt] [--no-start]
#     [--with-unbound | --with-recursor] [--with-ecs [--ecs-zones LIST]]
# Idempotent: safe to re-run. Supports Debian 12/13 and Ubuntu 22.04/24.04 on amd64/arm64.
set -eu

PANEL_URL='{{.PanelURL}}'
TOKEN=''
ADOPT=0
NO_START=0
WITH_UNBOUND=0
WITH_RECURSOR=0
WITH_ECS=0
# Local recursive resolver (Unbound or PowerDNS Recursor), the profile upstream 127.0.0.1:5335.
RESOLVER_IP='127.0.0.1'
RESOLVER_PORT=5335
REC_SERIES='54' # PowerDNS Recursor 5.4.x from repo.powerdns.com (rec-55 is still alpha)
# With --with-ecs the client subnet (/24, /56; never private or CGNAT ranges, dnsdist strips
# those) goes to every authoritative server, as public resolvers do. --ecs-zones LIST limits
# it to the name servers of those zones (e.g. CDNs only).
ECS_ZONES='all'
DNSDIST_SERIES='20' # dnsdist 2.0.x from repo.powerdns.com
AGENT_BIN=/usr/local/bin/dnsjos-agent
AGENT_CONF=/etc/dnsjos/agent.json
STATE_DIR=/var/lib/dnsjos
UNIT=/etc/systemd/system/dnsjos-agent.service

say() { printf '==> %s\n' "$*"; }
die() { printf 'dnsjos-install: error: %s\n' "$*" >&2; exit 1; }

usage() {
	cat <<EOF
usage: install.sh --token TOKEN [--panel URL] [--adopt] [--no-start]
                  [--with-unbound | --with-recursor] [--with-ecs [--ecs-zones LIST]]
  --token TOKEN  enrollment token from the panel (Nodes -> Add node)
  --panel URL    panel URL (default: $PANEL_URL)
  --adopt        take over a live dnsdist server: keep its dnsdist package, secrets,
                 listeners and port 53 setup (no repo, no install/upgrade, no resolved changes)
  --no-start     install the agent service but do not start it (review with 'dnsjos-agent plan')
  --with-unbound  also install Unbound as a local recursive, DNSSEC-validating resolver on
                  127.0.0.1:5335; point the profile upstreams at it to stop forwarding to public DNS
  --with-recursor the same with PowerDNS Recursor (repo.powerdns.com, same vendor as dnsdist)
  --with-ecs      let the local resolver pass EDNS Client Subnet from dnsdist on to
                  authoritative servers (also turn ECS on for 127.0.0.1:5335 in the profile)
  --ecs-zones LIST  only send it for these zones (comma or space separated domains);
                  default: all authoritative servers
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--token) [ $# -ge 2 ] || die "--token needs a value"; TOKEN=$2; shift 2 ;;
		--token=*) TOKEN=${1#--token=}; shift ;;
		--panel) [ $# -ge 2 ] || die "--panel needs a value"; PANEL_URL=$2; shift 2 ;;
		--panel=*) PANEL_URL=${1#--panel=}; shift ;;
		--adopt) ADOPT=1; shift ;;
		--no-start) NO_START=1; shift ;;
		--with-unbound) WITH_UNBOUND=1; shift ;;
		--with-recursor) WITH_RECURSOR=1; shift ;;
		--with-ecs) WITH_ECS=1; shift ;;
		--ecs-zones) [ $# -ge 2 ] || die "--ecs-zones needs a value"; ECS_ZONES=$2; shift 2 ;;
		--ecs-zones=*) ECS_ZONES=${1#--ecs-zones=}; shift ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; die "unknown argument: $1" ;;
	esac
done
PANEL_URL=${PANEL_URL%/}

[ "$(id -u)" -eq 0 ] || die "must run as root (pipe into 'sudo sh')"
[ -n "$TOKEN" ] || [ -s "$AGENT_CONF" ] || { usage >&2; die "--token is required"; }
case "$PANEL_URL" in http://*|https://*) ;; *) die "--panel must be an http(s) URL" ;; esac
[ "$WITH_UNBOUND$WITH_RECURSOR" != 11 ] || die "--with-unbound and --with-recursor both listen on $RESOLVER_IP:$RESOLVER_PORT: pick one"
[ "$WITH_ECS" = 0 ] || [ "$WITH_UNBOUND$WITH_RECURSOR" != 00 ] || die "--with-ecs needs --with-unbound or --with-recursor"
ECS_ZONES=$(printf '%s\n' "$ECS_ZONES" | tr ', ' '\n\n' | sed 's/\.$//' | grep . | sort -u)
[ "$ECS_ZONES" != all ] || ECS_ZONES=''
for z in $ECS_ZONES; do
	printf '%s\n' "$z" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]{0,252})$' || die "--ecs-zones: '$z' is not a domain name"
done

# ── 1. OS / architecture ────────────────────────────────────────────────────
[ -r /etc/os-release ] || die "cannot read /etc/os-release"
# shellcheck disable=SC1091
. /etc/os-release
OS_ID=${ID:-}
OS_VER=${VERSION_ID:-}
CODENAME=${VERSION_CODENAME:-}
case "$OS_ID:$OS_VER" in
	debian:12|debian:13|ubuntu:22.04|ubuntu:24.04) ;;
	*) die "unsupported OS ${PRETTY_NAME:-$OS_ID $OS_VER} (need Debian 12/13 or Ubuntu 22.04/24.04)" ;;
esac
[ -n "$CODENAME" ] || die "VERSION_CODENAME missing from /etc/os-release"

ARCH=$(dpkg --print-architecture 2>/dev/null || uname -m)
case "$ARCH" in
	amd64|x86_64) ARCH=amd64 ;;
	arm64|aarch64) ARCH=arm64 ;;
	*) die "unsupported architecture $ARCH (need amd64 or arm64)" ;;
esac
command -v systemctl >/dev/null 2>&1 || die "systemd is required"
say "installing DnsJos node on $OS_ID $OS_VER ($ARCH), panel $PANEL_URL"

export DEBIAN_FRONTEND=noninteractive
APT_OPTS='-y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold'

need_pkgs=''
command -v curl >/dev/null 2>&1 || need_pkgs="$need_pkgs curl"
command -v sha256sum >/dev/null 2>&1 || need_pkgs="$need_pkgs coreutils"
[ -f /etc/ssl/certs/ca-certificates.crt ] || need_pkgs="$need_pkgs ca-certificates"
command -v gpg >/dev/null 2>&1 || need_pkgs="$need_pkgs gnupg"
# TProxy (DNS redirect) rules are installed with nft.
command -v nft >/dev/null 2>&1 || need_pkgs="$need_pkgs nftables"
if [ -n "$need_pkgs" ]; then
	say "installing prerequisites:$need_pkgs"
	apt-get update -q
	# shellcheck disable=SC2086
	apt-get install $APT_OPTS $need_pkgs
fi

mkdir -p "$STATE_DIR"
chmod 0711 "$STATE_DIR" # dnsdist reads the CDB below it; secrets stay 0600

# ── 2. back up an existing /etc/dnsdist before anything can touch it ────────
if [ -d /etc/dnsdist ] && [ -n "$(ls -A /etc/dnsdist 2>/dev/null)" ]; then
	BACKUP="$STATE_DIR/pre-install-$(date +%Y%m%d-%H%M%S)"
	mkdir -p "$BACKUP"
	cp -a /etc/dnsdist/. "$BACKUP/"
	say "backed up /etc/dnsdist to $BACKUP"
fi

# ── 3. dnsdist 2.0 from repo.powerdns.com, pinned ───────────────────────────
# An existing dnsdist is never upgraded implicitly: adopted servers keep their version.
if [ "$ADOPT" = 1 ]; then
	command -v dnsdist >/dev/null 2>&1 || die "--adopt: dnsdist is not installed"
	[ -s /etc/dnsdist/dnsdist.yml ] || die "--adopt: /etc/dnsdist/dnsdist.yml not found"
	say "adopting the running dnsdist: $(dnsdist --version 2>/dev/null | head -n 1)"
elif command -v dnsdist >/dev/null 2>&1; then
	say "dnsdist already installed, leaving it as is: $(dnsdist --version 2>/dev/null | head -n 1)"
else
KEYRING=/etc/apt/keyrings/dnsdist-$DNSDIST_SERIES-pub.asc
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://repo.powerdns.com/FD380FBB-pub.asc -o "$KEYRING.tmp"
mv "$KEYRING.tmp" "$KEYRING"
chmod 0644 "$KEYRING"
echo "deb [signed-by=$KEYRING] https://repo.powerdns.com/$OS_ID $CODENAME-dnsdist-$DNSDIST_SERIES main" \
	>/etc/apt/sources.list.d/pdns-dnsdist.list
cat >/etc/apt/preferences.d/dnsdist-$DNSDIST_SERIES <<EOF
Package: dnsdist*
Pin: origin repo.powerdns.com
Pin-Priority: 600
EOF
say "installing dnsdist"
apt-get update -q
# shellcheck disable=SC2086
apt-get install $APT_OPTS dnsdist
command -v dnsdist >/dev/null 2>&1 || die "dnsdist was not installed"
say "$(dnsdist --version 2>/dev/null | head -n 1)"
fi

# Big UDP socket buffers (setUDPSocketBufferSizes 16 MB needs the kernel max raised).
cat >/etc/sysctl.d/90-dnsjos.conf <<EOF
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
EOF
sysctl -q -p /etc/sysctl.d/90-dnsjos.conf >/dev/null 2>&1 || true

# DNS server tuning. Never lowers a value an operator already raised (90-dns.conf etc.).
say "tuning the kernel and NIC for DNS"
BACKLOG=$(sysctl -n net.core.netdev_max_backlog 2>/dev/null || echo 0)
[ "$BACKLOG" -ge 16384 ] || BACKLOG=16384
PORT_LO=$(sysctl -n net.ipv4.ip_local_port_range 2>/dev/null | awk '{print $1}')
# A wider source port range only when no TCP service listens inside the ports it adds.
WIDE_PORTS=1
if [ "$PORT_LO" != 10000 ] &&
	ss -Hltn 2>/dev/null | awk '{n = split($4, a, ":"); p = a[n] + 0; if (p >= 10000 && p < 32768) bad = 1} END {exit !bad}'; then
	WIDE_PORTS=0
fi
{
	echo "# DnsJos DNS node tuning, written by install.sh."
	echo "net.core.netdev_max_backlog = $BACKLOG"
	if [ "$WIDE_PORTS" = 1 ]; then
		echo "# More source ports for recursive queries (spoofing resistance)."
		echo "net.ipv4.ip_local_port_range = 10000 65535"
	fi
	echo "# Keep the dnsdist and Unbound caches in RAM."
	echo "vm.swappiness = 10"
	echo "# RFS for single-queue NICs (dnsjos-nic-tuning.service)."
	echo "net.core.rps_sock_flow_entries = 32768"
	if modprobe tcp_bbr 2>/dev/null; then
		echo "# DoH/DoT over lossy/mobile links."
		echo "net.core.default_qdisc = fq"
		echo "net.ipv4.tcp_congestion_control = bbr"
	fi
} >/etc/sysctl.d/91-dnsjos-tuning.conf
if grep -q '= bbr' /etc/sysctl.d/91-dnsjos-tuning.conf; then echo tcp_bbr >/etc/modules-load.d/dnsjos-bbr.conf; fi
sysctl -q -p /etc/sysctl.d/91-dnsjos-tuning.conf >/dev/null 2>&1 || true
# Transparent huge pages: madvise (no compaction stalls); CPUs at full clock on bare metal.
: >/etc/tmpfiles.d/dnsjos-tuning.conf
[ ! -w /sys/kernel/mm/transparent_hugepage/enabled ] ||
	echo 'w /sys/kernel/mm/transparent_hugepage/enabled - - - - madvise' >>/etc/tmpfiles.d/dnsjos-tuning.conf
! grep -qsw performance /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors ||
	echo 'w /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor - - - - performance' >>/etc/tmpfiles.d/dnsjos-tuning.conf
systemd-tmpfiles --create /etc/tmpfiles.d/dnsjos-tuning.conf >/dev/null 2>&1 || true
# NIC: spread DNS over every CPU, re-applied at boot.
mkdir -p /usr/local/lib/dnsjos
cat >/usr/local/lib/dnsjos/nic-tuning.sh <<'EOF'
#!/bin/sh
# Written by the DnsJos installer: spread DNS packets over every CPU.
dev=$(ip -4 route show default | awk '{print $5; exit}')
[ -n "$dev" ] || exit 0
for l in /sys/class/net/"$dev"/lower_*; do [ -e "$l" ] && dev=${l##*/lower_}; done # VLAN: its NIC
# Multi-queue NICs hash UDP on IPs only by default: one busy source pins one queue.
if command -v ethtool >/dev/null 2>&1; then
	ethtool -N "$dev" rx-flow-hash udp4 sdfn 2>/dev/null
	ethtool -N "$dev" rx-flow-hash udp6 sdfn 2>/dev/null
fi
# Single-queue NICs (common on VMs): RPS/RFS spreads receive processing in software.
n=$(nproc); [ "$n" -le 32 ] || n=32
if [ "$(ls -d /sys/class/net/"$dev"/queues/rx-* | wc -l)" = 1 ] && [ "$n" -gt 1 ]; then
	printf '%x\n' $(((1 << n) - 1)) >/sys/class/net/"$dev"/queues/rx-0/rps_cpus
	echo 32768 >/sys/class/net/"$dev"/queues/rx-0/rps_flow_cnt
fi
exit 0
EOF
chmod 0755 /usr/local/lib/dnsjos/nic-tuning.sh
cat >/etc/systemd/system/dnsjos-nic-tuning.service <<'EOF'
[Unit]
Description=DnsJos NIC tuning (UDP RSS on ports, RPS/RFS on single-queue NICs)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/dnsjos/nic-tuning.sh

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable dnsjos-nic-tuning.service >/dev/null 2>&1
systemctl restart dnsjos-nic-tuning.service || true
# default_qdisc only applies to new qdiscs: rebuild the NIC's root qdisc once now.
NIC=$(ip -4 route show default | awk '{print $5; exit}')
for l in /sys/class/net/"$NIC"/lower_*; do [ -e "$l" ] && NIC=${l##*/lower_}; done
if [ -n "$NIC" ] && grep -q '= fq$' /etc/sysctl.d/91-dnsjos-tuning.conf && command -v tc >/dev/null 2>&1; then
	case $(tc qdisc show dev "$NIC" | awk 'NR == 1 {print $2}') in
	mq) tc qdisc replace dev "$NIC" root mq ;;
	fq) ;;
	*) tc qdisc replace dev "$NIC" root fq ;;
	esac
fi

# ── 4. free port 53 from the systemd-resolved stub listener ─────────────────
if [ "$ADOPT" = 0 ] && systemctl is-active --quiet systemd-resolved 2>/dev/null; then
	if ! grep -rqs '^DNSStubListener=no' /etc/systemd/resolved.conf /etc/systemd/resolved.conf.d; then
		say "disabling the systemd-resolved stub listener on :53"
		mkdir -p /etc/systemd/resolved.conf.d
		printf '[Resolve]\nDNSStubListener=no\n' >/etc/systemd/resolved.conf.d/dnsjos.conf
		systemctl restart systemd-resolved
	fi
	# The stub resolv.conf points at 127.0.0.53, which no longer answers.
	if [ "$(readlink /etc/resolv.conf 2>/dev/null || true)" != /run/systemd/resolve/resolv.conf ] &&
		grep -qs '^nameserver 127\.0\.0\.53' /etc/resolv.conf; then
		ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf
	fi
fi

# ── 4b. optional local recursive resolver on loopback (Unbound or Recursor) ──
# Config goes in before the package so the resolver never starts on its default :53 (dnsdist's).
if [ "$WITH_UNBOUND$WITH_RECURSOR" != 00 ]; then
	# Both listen on the same port: never install one while the other runs.
	for other in unbound pdns-recursor; do
		case "$other:$WITH_UNBOUND" in unbound:1 | pdns-recursor:0) continue ;; esac
		! systemctl is-active --quiet "$other" 2>/dev/null ||
			die "$other is running on this node: 'systemctl disable --now $other' first to switch resolvers"
	done
	# Sized from the host: a thread per core, at most 8.
	RES_THREADS=$(nproc 2>/dev/null || echo 1)
	[ "$RES_THREADS" -le 8 ] || RES_THREADS=8
	# Only use IPv6 name servers when IPv6 actually reaches the internet: a default route
	# with a dead uplink makes every first lookup wait for IPv6 timeouts.
	RES_IP6=no
	if [ -n "$(ip -6 route show default 2>/dev/null)" ] &&
		{ ping -6 -c 1 -W 2 2001:4860:4860::8888 || ping -6 -c 1 -W 2 2606:4700:4700::1111; } >/dev/null 2>&1; then
		RES_IP6=yes
	fi
fi

if [ "$WITH_UNBOUND" = 1 ]; then
	say "installing unbound on $RESOLVER_IP:$RESOLVER_PORT"
	mkdir -p /etc/unbound/unbound.conf.d
	# Power-of-two slabs cut lock contention; rrset cache = RAM/16 in 64m..1g, msg cache half
	# that (Unbound uses ~2.5x the configured size).
	UB_SLABS=1
	while [ "$UB_SLABS" -lt "$RES_THREADS" ]; do UB_SLABS=$((UB_SLABS * 2)); done
	UB_RRSET=$(awk '/^MemTotal:/ {m = int($2 / 1024 / 16); if (m < 64) m = 64; if (m > 1024) m = 1024; print m; exit}' /proc/meminfo)
	UB_RRSET=${UB_RRSET:-128}
	# ECS: pass the client subnet dnsdist adds on to authoritative servers (all, or only
	# --ecs-zones); the subnetcache module keeps per-subnet answers apart, scope-0 ones shared.
	UB_ECS=''
	if [ "$WITH_ECS" = 1 ]; then
		UB_ECS='
    # EDNS Client Subnet from dnsdist, passed on to authoritative servers
    module-config: "subnetcache validator iterator"'
		if [ -z "$ECS_ZONES" ]; then
			UB_ECS="$UB_ECS
    send-client-subnet: 0.0.0.0/0
    send-client-subnet: ::0/0"
		fi
		for z in $ECS_ZONES; do UB_ECS="$UB_ECS
    client-subnet-zone: $z"; done
	fi
	cat >/etc/unbound/unbound.conf.d/dnsjos.conf <<EOF
# Managed by the DnsJos installer: recursive resolver behind dnsdist, loopback only.
# Re-run the installer with --with-unbound to resize after a CPU/RAM change.
server:
    interface: ${RESOLVER_IP}@${RESOLVER_PORT}
    access-control: 127.0.0.0/8 allow
    do-ip6: ${RES_IP6}
    hide-identity: yes
    hide-version: yes
    # cache counts, rcodes and query types for unbound_exporter / unbound-control stats
    extended-statistics: yes

    # threads and sockets
    num-threads: ${RES_THREADS}
    so-reuseport: yes
    so-rcvbuf: 4m
    so-sndbuf: 4m
    outgoing-range: 8192
    num-queries-per-thread: 4096
    incoming-num-tcp: 256
    outgoing-num-tcp: 64

    # caches
    msg-cache-slabs: ${UB_SLABS}
    rrset-cache-slabs: ${UB_SLABS}
    infra-cache-slabs: ${UB_SLABS}
    key-cache-slabs: ${UB_SLABS}
    rrset-cache-size: ${UB_RRSET}m
    msg-cache-size: $((UB_RRSET / 2))m
    key-cache-size: $((UB_RRSET / 8))m
    neg-cache-size: $((UB_RRSET / 16))m
    cache-max-negative-ttl: 300

    # latency: refresh popular names before they expire, answer stale while refreshing
    # (RFC 8767), and synthesize NXDOMAIN from cached NSEC (RFC 8198)
    prefetch: yes
    prefetch-key: yes
    serve-expired: yes
    serve-expired-ttl: 86400
    serve-expired-client-timeout: 0
    aggressive-nsec: yes
    qname-minimisation: yes
    rrset-roundrobin: yes
    harden-below-nxdomain: yes
${UB_ECS}
EOF
	# The package would point the host's resolv.conf at 127.0.0.1:53, where dnsdist (not Unbound) answers.
	systemctl mask unbound-resolvconf.service >/dev/null 2>&1 || true
	command -v unbound >/dev/null 2>&1 || {
		apt-get update -q
		# shellcheck disable=SC2086
		apt-get install $APT_OPTS unbound
	}
	unbound-checkconf >/dev/null || die "unbound config check failed (unbound-checkconf)"
	systemctl enable unbound >/dev/null 2>&1
	systemctl restart unbound
	say "unbound ready: set the profile upstream to $RESOLVER_IP:$RESOLVER_PORT"
fi

if [ "$WITH_RECURSOR" = 1 ]; then
	say "installing PowerDNS Recursor $REC_SERIES on $RESOLVER_IP:$RESOLVER_PORT"
	# Record cache ~250 entries per MB of RAM (4 GB: ~1M, Recursor's default), 200k..2M;
	# the packet cache half that.
	REC_ENTRIES=$(awk '/^MemTotal:/ {m = int($2 / 1024 * 250); if (m < 200000) m = 200000; if (m > 2000000) m = 2000000; print m; exit}' /proc/meminfo)
	REC_ENTRIES=${REC_ENTRIES:-1000000}
	REC_SRC6=''
	[ "$RES_IP6" = no ] || REC_SRC6="
    - '::'"
	REC_ECS_IN='' REC_ECS_OUT='' REC_ECS=''
	if [ "$WITH_ECS" = 1 ]; then
		# Take the client subnet dnsdist adds and pass it on (all servers, or only --ecs-zones).
		REC_ECS_IN='
  use_incoming_edns_subnet: true'
		REC_ECS_OUT='
  edns_subnet_allow_list:'
		for z in ${ECS_ZONES:-0.0.0.0/0 ::/0}; do REC_ECS_OUT="$REC_ECS_OUT
    - '$z'"; done
		# Clients dnsdist sends with an empty /0 (private/CGNAT): send this node's address,
		# not 127.0.0.1, so CDNs answer for the node's location as without ECS.
		REC_PUB4=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
		# Behind NAT (cloud VMs, a router) that source is private: sending it would leak an
		# internal subnet, so only use a public address (the ranges dnsdist strips, render.go).
		case $REC_PUB4 in
		10.* | 127.* | 169.254.* | 192.168.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[01].* | \
			100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) REC_PUB4='' ;;
		esac
		[ -z "$REC_PUB4" ] || REC_ECS="
ecs:
  scope_zero_address: $REC_PUB4"
	fi
	mkdir -p /etc/powerdns/recursor.d
	cat >/etc/powerdns/recursor.d/dnsjos.yml <<EOF
# Managed by the DnsJos installer: recursive resolver behind dnsdist, loopback only.
# Re-run the installer with --with-recursor to resize after a CPU/RAM change.
incoming:
  listen:
    - '${RESOLVER_IP}:${RESOLVER_PORT}'
  allow_from:
    - 127.0.0.0/8${REC_ECS_IN}
recursor:
  threads: ${RES_THREADS}
outgoing:
  source_address:
    - 0.0.0.0${REC_SRC6}${REC_ECS_OUT}
dnssec:
  # Always validate (the default "process" only validates when the client asks).
  validation: validate
recordcache:
  max_entries: ${REC_ENTRIES}
  # Refresh names when 10% of their TTL is left (prefetch); serve stale for up to a day
  # (2880 x 30 s) when a refresh fails (RFC 8767).
  refresh_on_ttl_perc: 10
  serve_stale_extensions: 2880
packetcache:
  max_entries: $((REC_ENTRIES / 2))${REC_ECS}
EOF
	if ! command -v pdns_recursor >/dev/null 2>&1; then
		REC_KEYRING=/etc/apt/keyrings/pdns-rec-pub.asc
		install -d -m 0755 /etc/apt/keyrings
		curl -fsSL https://repo.powerdns.com/FD380FBB-pub.asc -o "$REC_KEYRING.tmp"
		mv "$REC_KEYRING.tmp" "$REC_KEYRING"
		chmod 0644 "$REC_KEYRING"
		echo "deb [signed-by=$REC_KEYRING] https://repo.powerdns.com/$OS_ID $CODENAME-rec-$REC_SERIES main" \
			>/etc/apt/sources.list.d/pdns-rec.list
		cat >/etc/apt/preferences.d/pdns-rec-$REC_SERIES <<EOF
Package: pdns-recursor*
Pin: origin repo.powerdns.com
Pin-Priority: 600
EOF
		apt-get update -q
		# shellcheck disable=SC2086
		apt-get install $APT_OPTS pdns-recursor
	fi
	systemctl enable pdns-recursor >/dev/null 2>&1
	systemctl restart pdns-recursor || die "pdns-recursor did not start: journalctl -u pdns-recursor"
	say "PowerDNS Recursor ready: set the profile upstream to $RESOLVER_IP:$RESOLVER_PORT"
fi

# ── 5. agent binary (sha256-verified) ───────────────────────────────────────
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM
say "downloading dnsjos-agent (linux/$ARCH)"
curl -fsSL "$PANEL_URL/dl/agent/linux/$ARCH" -o "$TMP/dnsjos-agent" ||
	die "agent download failed: $PANEL_URL/dl/agent/linux/$ARCH"
WANT=$(curl -fsSL "$PANEL_URL/dl/agent/linux/$ARCH.sha256" | awk '{print $1; exit}')
GOT=$(sha256sum "$TMP/dnsjos-agent" | awk '{print $1}')
if [ -z "$WANT" ] || [ "$WANT" != "$GOT" ]; then
	die "agent checksum mismatch (want '$WANT', got '$GOT')"
fi
install -m 0755 "$TMP/dnsjos-agent" "$AGENT_BIN.new"
mv -f "$AGENT_BIN.new" "$AGENT_BIN"

# ── 6. enroll (skipped when already enrolled; tokens are single-use) ────────
if [ -s "$AGENT_CONF" ]; then
	say "already enrolled ($AGENT_CONF exists); delete it and re-run with a new token to re-enroll"
else
	say "enrolling with the panel"
	if [ "$ADOPT" = 1 ]; then
		"$AGENT_BIN" enroll --panel "$PANEL_URL" --token "$TOKEN" --adopt || die "enrollment failed"
	else
		"$AGENT_BIN" enroll --panel "$PANEL_URL" --token "$TOKEN" || die "enrollment failed"
	fi
	[ -s "$AGENT_CONF" ] || die "enrollment did not write $AGENT_CONF"
fi

# ── 7. systemd service ──────────────────────────────────────────────────────
cat >"$UNIT" <<'EOF'
[Unit]
Description=DnsJos node agent (manages dnsdist)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dnsjos-agent run
Restart=always
RestartSec=5
# SIGTERM the agent only: it waits for a running apt/dpkg upgrade or dnsdist restart
# before exiting, so give it time instead of killing dpkg mid-way.
KillMode=mixed
TimeoutStopSec=15min
StateDirectory=dnsjos
StateDirectoryMode=0711

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
if [ "$NO_START" = 1 ]; then
	say "agent installed but NOT started. Review what it would change, then start it:"
	say "  $AGENT_BIN plan"
	say "  systemctl enable --now dnsjos-agent"
	exit 0
fi
systemctl enable dnsjos-agent >/dev/null 2>&1
systemctl restart dnsjos-agent

NODE_ID=$(sed -n 's/.*"node_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$AGENT_CONF" | head -n 1)
say "done: node $(hostname) (id ${NODE_ID:-unknown}) is managed by $PANEL_URL"
say "it appears as online in the panel within a few seconds; logs: journalctl -u dnsjos-agent -f"
