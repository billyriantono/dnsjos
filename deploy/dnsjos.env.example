# /etc/dnsjos/dnsjos.env (mode 0640, root:dnsjos)
DNSJOS_LISTEN=127.0.0.1:8080
DNSJOS_DATABASE_URL=postgres://dnsjos:CHANGE_ME@127.0.0.1:5432/dnsjos?sslmode=disable
DNSJOS_DATA_DIR=/var/lib/dnsjos
DNSJOS_PUBLIC_URL=https://dnsjos.example.com
DNSJOS_SECURE_COOKIES=auto
DNSJOS_LOG_LEVEL=info
# Only used when the users table is empty; remove after the first start.
#DNSJOS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#DNSJOS_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
