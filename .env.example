# Local development (make dev reads DEV_DB; export these for `go run ./cmd/dnsjos`).
DNSJOS_LISTEN=127.0.0.1:8080
DNSJOS_DATABASE_URL=postgres://postgres@127.0.0.1:5432/dnsjos?sslmode=disable
DNSJOS_DATA_DIR=./data
DNSJOS_PUBLIC_URL=http://127.0.0.1:8080
DNSJOS_SECURE_COOKIES=auto
DNSJOS_LOG_LEVEL=debug
DNSJOS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
DNSJOS_BOOTSTRAP_ADMIN_PASSWORD=admin-password
# Tests that need Postgres are skipped unless this is set:
DNSJOS_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/dnsjos_test?sslmode=disable
